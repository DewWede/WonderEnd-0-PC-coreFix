      public function keyPressed(param1:KeyboardEvent) : *
      {
         if(this.pause == 1)
         {
            if(this.mapx == 5)
            {
               if(this.onepush == 1 && (this.pccontrolsx == 1 && (param1.keyCode == Keyboard.SPACE || param1.keyCode == 69) || this.pccontrolsx == 2 && (param1.keyCode == Keyboard.UP || param1.keyCode == 69 || param1.keyCode == 87)))
               {
                  if(this.storypick >= 1 && this.talkx.currentFrame == 3 && this.talkx.visible == true)
                  {
                     this.talkx.pushstory();
                     trace("push story/ stopall = " + this.stopall);
                  }
                  else if((this.handlocker == 2 || this.moongrabtimer > 0) && this.startstage == 2)
                  {
                     this.tryescape();
                     trace("push escape");
                  }
                  else if(this.fullhiding == 2 && this.startstage == 2)
                  {
                     this.fullhiding = 3;
                     trace("push fullhiding");
                     this.bg.insidehide.gotoAndPlay("exit");
                     this.bg["hide" + this.hidehit].gotoAndPlay("exit");
                     this.hidefg.gotoAndStop(1);
                  }
                  else if(this.opennote == 2 && this.startstage == 2)
                  {
                     trace("close note");
                     this.noteopen.gotoAndPlay("close");
                     this.stopall = 1;
                     this.opennote = 1;
                     this.stopmonster = 1;
                     this.ui.visible = true;
                  }
                  else if(this.openpc == 3 && this.tutorialx == 1 && this.startstage == 2)
                  {
                     trace("close pc");
                     this.pc.pc.removeevents();
                     this.closepc();
                  }
                  else if(this.opencam == 3 && this.tutorialx == 1 && this.startstage == 2)
                  {
                     trace("close cam");
                     this.closecam();
                  }
                  else if(this.moongrabtimer <= 0 && this.startstage == 2)
                  {
                     this.Action();
                     trace("Action");
                  }
                  this.onepush = 2;
               }
               if(this.startstage == 2)
               {
                  if(param1.keyCode == 68 || param1.keyCode == Keyboard.RIGHT)
                  {
                     this.walkright();
                  }
                  if(param1.keyCode == 65 || param1.keyCode == Keyboard.LEFT)
                  {
                     this.walkleft();
                  }
                  if(this.pccontrolsx == 1 && (param1.keyCode == 87 || param1.keyCode == Keyboard.UP) || this.pccontrolsx == 2 && param1.keyCode == Keyboard.SPACE)
                  {
                     this.Jump();
                  }
                  if(param1.keyCode == 83 || param1.keyCode == Keyboard.DOWN)
                  {
                     this.Drop();
                  }
                  if(param1.keyCode == 70 && this.onepush == 1 && this.stopall == 1)
                  {
                     if(this.dropstage == "moka" || this.dropstage == "rabi" || this.dropstage == "null")
                     {
                        this.throwtali();
                     }
                     else
                     {
                        this.flashlightswitch();
                     }
                     this.onepush = 2;
                  }
                  if((this.dropstage == "school" || this.dropstage == "intro2") && param1.keyCode == Keyboard.SHIFT && this.onepush == 1)
                  {
                     if(param1.keyCode == Keyboard.SHIFT && this.onepush == 1)
                     {
                        this.Run();
                        this.onepush = 2;
                     }
                  }
               }
            }
            else if(this.mapx == 6 && this.onepush == 1 && param1.keyCode == Keyboard.SPACE)
            {
               if(this.autof == 1)
               {
                  if(this.talkxx.automode == 2 || this.talkxx.startskip == 2 || this.talkxx.logmode == 2)
                  {
                     this.talkxx.clickscreen();
                     this.onepush = 2;
                  }
                  else
