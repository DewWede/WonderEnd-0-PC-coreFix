      public function addParticles() : void
      {
         if(this.dropstage == "intro" || this.dropstage == "intro2")
         {
            if(this.mapx == 6)
            {
               if(this.bgscene.currentFrame == 5)
               {
                  this.particlex = 7;
               }
               else
               {
                  this.particlex = 4;
               }
               this.numberOfParticles = 50;
            }
            else if(this.mapx == 5)
            {
               if(this.intropart == 1)
               {
                  this.particlex = 2;
                  this.numberOfParticles = 200;
               }
               else
               {
                  this.particlex = 4;
                  this.numberOfParticles = 200;
               }
            }
         }
         else if(this.dropstage == "seeker")
         {
            this.numberOfParticles = 350;
            if(this.difficulty == 1)
            {
               if(this.yuniphase >= 6)
               {
                  this.particlex = 2;
               }
               else
               {
                  this.particlex = 4;
               }
            }
            else
            {
               this.particlex = 3;
            }
         }
         else if(this.dropstage == "school")
         {
            this.numberOfParticles = 300;
            this.particlex = 4;
         }
         else if(this.dropstage == "moka")
         {
            this.numberOfParticles = 300;
            if(this.difficulty == 1)
            {
               this.particlex = 1;
            }
            else
            {
               this.particlex = 3;
            }
         }
         else if(this.dropstage == "rabi")
         {
            this.numberOfParticles = 70;
            if(this.difficulty == 1)
            {
               this.particlex = 8;
            }
            else
            {
               this.particlex = 3;
            }
         }
         else if(this.dropstage == "null")
         {
            this.numberOfParticles = 250;
            if(this.difficulty == 1)
            {
               this.particlex = 1;
            }
            else
            {
               this.particlex = 3;
            }
         }
         else if(this.dropstage == "endloop")
         {
            this.numberOfParticles = 40;
            if(this.difficulty == 1)
            {
               this.particlex = 4;
            }
            else
            {
               this.particlex = 2;
            }
         }
         var _loc1_:uint = 0;
         while(_loc1_ < this.numberOfParticles)
         {
            this.particleVect.push(new Particle());
            if(this.dropstage == "intro" && this.mapx == 6 || this.dropstage == "endloop")
            {
               this.particleVect[_loc1_].x = Math.random() * 1000;
            }
            else
            {
               this.particleVect[_loc1_].x = Math.random() * 8000;
            }
            this.particleVect[_loc1_].y = Math.random() * stage.stageHeight;
            this.particleVect[_loc1_].alpha = Math.random();
            this.particleVect[_loc1_].gotoAndStop(this.particlex);
            if(this.particlex == 8)
            {
               this.particleVect[_loc1_].scaleX = Math.random() * 1.6 + 1.4;
            }
            else
            {
               this.particleVect[_loc1_].scaleX = Math.random() * 0.7 + 0.2;
            }
            this.particleVect[_loc1_].scaleY = this.particleVect[_loc1_].scaleX;
            if(this.dropstage == "intro" && this.mapx == 6 || this.dropstage == "endloop")
            {
               this.particleVect[_loc1_].mapxValue = 2;
            }
            else
            {
               this.particleVect[_loc1_].mapxValue = 1;
            }
            addChild(this.container);
            this.container.addChild(this.particleVect[_loc1_]);
            setChildIndex(this.container,0);
            if(this.mapx == 5)
            {
               if(this.dropstage == "moka" || this.dropstage == "seeker" || this.dropstage == "null")
               {
                  setChildIndex(this.mainfg,0);
                  setChildIndex(this.bg,0);
                  setChildIndex(this.bgnomove,0);
                  setChildIndex(this.bgmid,0);
                  setChildIndex(this.bgback,0);
                  setChildIndex(this.bgend,0);
               }
               else if(this.dropstage == "school")
               {
                  setChildIndex(this.mainfg,0);
                  setChildIndex(this.bg,0);
                  setChildIndex(this.bgnomove,0);
                  setChildIndex(this.moonx,0);
                  setChildIndex(this.bgmid,0);
                  setChildIndex(this.bgback,0);
                  setChildIndex(this.bgend,0);
               }
               else
               {
                  setChildIndex(this.bg,0);
                  setChildIndex(this.bgnomove,0);
                  setChildIndex(this.bgmid,0);
                  setChildIndex(this.bgback,0);
                  setChildIndex(this.bgend,0);
               }
            }
            else if(this.mapx == 6)
            {
               setChildIndex(this.bgscene,0);
            }
            _loc1_++;
         }
      }
      
      public function removeParticles() : void
      {
         var _loc1_:uint = 0;
         while(_loc1_ < this.numberOfParticles)
         {
            this.particleVect[_loc1_].ParticleDestructor();
            this.container.removeChild(this.particleVect[_loc1_]);
            _loc1_++;
         }
         while(this.particleVect.length > 0)
         {
            this.particleVect.pop();
         }
         removeChild(this.container);
      }
      
