               this.ui.runbt.gotoAndStop(this.runmode);
               this.staminatimer = 45;
               this.ui.staminabar.gotoAndPlay(2);
               addEventListener(Event.ENTER_FRAME,this.stamtimer);
            }
         }
         else if(this.stamina < this.maxstamina)
         {
            if(this.staminatimer == 0)
            {
               this.stamina += 3;
            }
         }
         else
         {
            this.stamina = this.maxstamina;
         }
         if(this.stamina < this.maxstamina)
         {
            this.ui.staminabar.visible = true;
            this.ui.staminabar.barx.scaleX = this.stamina / this.maxstamina;
