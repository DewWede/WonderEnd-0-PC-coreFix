      public function startgo() : void
      {
         if(this.dropstage == "school")
         {
            trace("start values");
            this.stopall = 1;
            this.stopmonster = 1;
            this.ui.visible = true;
            this.ui.jumpbt.visible = true;
            this.ui.arrowkeys.visible = true;
            this.ui.runbt.visible = true;
            this.ui.livesx.visible = true;
            this.lockmovement = 1;
            this.lockjump = 1;
            this.locksprint = 1;
            this.moonx.visible = true;
            this.moonx.gotoAndPlay("start");
            this.tutorialx = 1;
            this.chatmsg = 1;
            if(this.difficulty <= 3)
            {
               if(this.o2 <= 1)
               {
                  this.bg.npc1.hitbox.y = 37;
                  this.bg.npc1.visible = true;
               }
            }
            else
            {
               this.bg.npc1.visible = false;
               this.bg.npc1.x = 0;
               this.bg.npc1.y = 0;
            }
            if(!(this.stagepick == 1 && this.o2 == 2))
            {
               this.newtasktimer = 0;
               this.startquicktask();
               addEventListener(Event.ENTER_FRAME,this.timeevent);
               addEventListener(Event.ENTER_FRAME,this.pianoevent);
            }
            this.showtime();
         }
         else if(this.dropstage == "seeker")
         {
            trace("start Seeker stage");
            this.movestop();
            this.lockmovement = 1;
            this.stopall = 1;
            this.stopmonster = 1;
         }
         else if(this.dropstage == "soul")
         {
            this.stopall = 1;
            this.stopmonster = 1;
         }
         else if(this.dropstage == "moka")
         {
            this.startmoka();
            this.stopall = 1;
            this.stopmonster = 1;
         }
         else if(this.dropstage == "rabi")
         {
            this.rabi_start();
            this.bgm = 25;
            this.playmusic();
            this.stopall = 1;
            this.stopmonster = 1;
         }
         else if(this.dropstage == "null")
         {
            this.null_start();
            this.bgm = 22;
            this.playmusic();
            this.stopall = 1;
            this.stopmonster = 1;
            this.staticfg.gotoAndPlay("glitch2");
         }
         else if(this.dropstage == "endloop")
         {
            this.endloop_start();
            this.stopall = 1;
            this.stopmonster = 1;
            if(this.difficulty == 2)
            {
               this.flashlight = 1;
               this.flashlightswitch();
               this.char.char.gotoAndPlay("still_light");
            }
         }
         else if(this.stagepick == 17)
         {
            this.stopall = 1;
            this.stopmonster = 1;
            this.flashlight = 1;
            this.flashlightswitch();
            this.char.char.gotoAndPlay("still_light");
         }
         else
         {
            this.char.char.gotoAndPlay("still");
            this.stopall = 1;
            this.stopmonster = 1;
         }
         this.touchgo = 1;
         this.touchbg.gotoAndStop(3);
         this.ui.staminabar.visible = false;
         this.ui.visible = true;
         this.startstage = 2;
         this.alanface = 1;
         this.changeface();
         if(this.tutorialx == 1)
         {
            this.checkallhit();
            this.checknohit();
            this.checkallhit();
            this.checknohit();
            addEventListener(Event.ENTER_FRAME,this.eFrame);
            addEventListener(Event.ENTER_FRAME,this.speedtimeevent);
         }
