      public function flyingheadloop(param1:Event) : void
      {
         if(this.darktrigger == 1)
         {
            if(this.startside == 1)
            {
               if(this.char.x > this.cdrnd)
               {
                  this.darktrigger = 2;
               }
            }
            else if(this.startside == 2)
            {
               if(this.char.x < this.cdrnd)
               {
                  this.darktrigger = 2;
               }
            }
         }
         else if(this.darktrigger == 2)
         {
            this.bg.flyinghead.visible = true;
            this.bg.flyinghead.gotoAndStop(Math.floor(Math.random() * 8) + 1);
            this.staticfg.gotoAndPlay("faststatic");
            if(this.startside == 1)
            {
               this.bg.flyinghead.x = this.char.x + 600;
            }
            else
            {
