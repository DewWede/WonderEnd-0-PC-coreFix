      public function gethurt() : void
      {
         if(this.canthittimer < 1)
         {
            if(this.godmode == 1)
            {
               if(this.stagepick <= 11)
               {
                  this.canthittimer = 120;
               }
               else
               {
                  this.canthittimer = 94;
               }
               addEventListener(Event.ENTER_FRAME,this.gethurtflash);
               if(this.openpc == 3)
               {
                  this.closepc();
               }
               if(this.opencam == 3)
               {
                  this.closecam();
               }
               if(this.dropstage == "moka")
               {
                  this.sfx = 23;
                  this.playsfx();
               }
               if(this.dropstage == "school")
               {
                  if(this.heals < 4)
                  {
                     this.bg.alanroom.healx.visible = true;
                     this.bg.alanroom.healx.gotoAndPlay(1);
                  }
                  else
                  {
                     this.bg.alanroom.healx.visible = false;
                     this.bg.alanroom.healx.gotoAndStop(1);
                  }
               }
               if(this.dropstage == "soul")
               {
                  if(this.heals < 4)
                  {
                     this.bg.rooms.healx.visible = true;
                     this.bg.rooms.healx.gotoAndPlay(1);
                  }
                  else
                  {
                     this.bg.rooms.healx.visible = false;
                     this.bg.rooms.healx.gotoAndStop(1);
                  }
               }
               if(this.hp >= 2)
               {
                  this.extrahit = 0;
                  this.sfx = 6;
                  this.playsfx();
                  --this.hp;
                  this.hurtfg.gotoAndPlay("join");
                  this.hurtfg.mouseEnabled = false;
                  this.hurtfg.x1.mouseEnabled = false;
                  this.hurtfg.x2.mouseEnabled = false;
                  this.hurtfg.x3.mouseEnabled = false;
                  this.jumpscarego.gotoAndPlay("jumpscare" + this.jumpscare);
                  this.alanface = 2;
                  this.changeface();
               }
               else if(this.hp <= 1 && this.stagepick >= 1)
               {
                  this.hurtfg.gotoAndPlay("quit");
                  this.stopall = 2;
                  this.jumpscarego.gotoAndPlay("gameover" + this.jumpscare);
                  this.sfx = 6;
                  this.playsfx();
                  this.hp = 0;
                  this.stopmonster = 2;
                  this.winner = 1;
                  this.fadefg.gotoAndStop(1);
                  this.hidefg.gotoAndStop(2);
                  this.ui.visible = false;
                  this.xvelocity = 0;
                  this.yvelocity = 0;
                  this.walkrightstop();
                  this.walkleftstop();
                  this.removeallevents();
                  trace("gameover");
               }
            }
            this.ui.livesx.gotoAndStop(this.hp);
            this.ui.livesxx.gotoAndStop(this.hp);
            if(this.maxhp == 3)
            {
               this.ui.livesx.visible = true;
            }
            else
            {
               this.ui.livesxx.visible = true;
            }
            if(this.hp == 0)
            {
               this.ui.livesx.gotoAndStop(4);
               this.ui.livesxx.gotoAndStop(6);
            }
            this.camshakego();
            this.staticoff();
            this.checkallhit();
            this.checknohit();
         }
      }
      
