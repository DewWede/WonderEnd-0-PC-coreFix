      public function showtime() : void
      {
         this.ui.arrowkeys.visible = false;
         this.ui.jumpbt.visible = false;
         this.ui.runbt.visible = false;
         this.ui.actionbt.visible = false;
         this.ui.flashlightbt.visible = false;
         this.ui.dropbt.visible = false;
         if(!(this.stagepick == 1 && this.o2 == 2))
         {
            this.bg.glowx.clockx.gotoAndStop(this.min);
            if(this.min < 11)
            {
               this.add0 = "0";
            }
            else if(this.min >= 61 && this.min < 71)
            {
               this.add0 = "0";
            }
            else if(this.min >= 121 && this.min < 131)
            {
               this.add0 = "0";
            }
            else if(this.min >= 181 && this.min < 191)
            {
               this.add0 = "0";
            }
            else if(this.min >= 241 && this.min < 251)
            {
               this.add0 = "0";
            }
            else if(this.min >= 301 && this.min < 311)
            {
               this.add0 = "0";
            }
            else if(this.min >= 361 && this.min < 371)
            {
               this.add0 = "0";
            }
            else if(this.min >= 421 && this.min < 431)
            {
               this.add0 = "0";
            }
            else
            {
               this.add0 = "";
            }
            if(this.min < 61)
            {
               this.timeshow = "0:" + this.add0 + (this.min - 1) + " AM";
            }
            else if(this.min >= 61 && this.min < 121)
            {
               this.timeshow = "1:" + this.add0 + (this.min - 1 - 60) + " AM";
            }
            else if(this.min >= 121 && this.min < 181)
            {
               this.timeshow = "2:" + this.add0 + (this.min - 1 - 120) + " AM";
            }
            else if(this.min >= 181 && this.min < 241)
            {
               this.timeshow = "3:" + this.add0 + (this.min - 1 - 180) + " AM";
            }
            else if(this.min >= 241 && this.min < 301)
            {
               this.timeshow = "4:" + this.add0 + (this.min - 1 - 240) + " AM";
            }
            else if(this.min >= 301 && this.min < 361)
            {
               this.timeshow = "5:" + this.add0 + (this.min - 1 - 300) + " AM";
            }
            else if(this.min >= 361 && this.min < 421)
            {
               this.timeshow = "6:" + this.add0 + (this.min - 1 - 360) + " AM";
            }
            if(this.openpc >= 2)
            {
               if(this.pcgamestart == 1 && this.pc.pc.pages.currentFrame == 3)
               {
                  this.pc.pc.pages.timexx.text = this.timeshow;
               }
               this.pc.pc.timexx.text = this.timeshow;
            }
            if(this.bg.glowx.pc.currentFrame <= 2)
            {
               this.bg.glowx.pc.timex.text = this.timeshow;
            }
         }
