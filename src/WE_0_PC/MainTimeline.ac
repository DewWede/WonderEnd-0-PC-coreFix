               {
                  this.doorx = -50;
               }
               else
               {
                  this.doorx = 0;
               }
            }
            else
            {
               this.doorx = 0;
            }
            if(this.char.x < this.bg["qportal" + this.qportalhit].x - 2 + this.doorx)
            {
               this.char.x += 4;
               this.chardir = 1;
               this.char.scaleX = this.charscale;
            }
            else if(this.char.x > this.bg["qportal" + this.qportalhit].x + 2 + this.doorx)
            {
               this.char.x -= 4;
               this.chardir = 2;
               this.char.scaleX = -this.charscale;
            }
            else
            {
               this.char.x = this.bg["qportal" + this.qportalhit].x + this.doorx;
            }
            this.lightfollow();
            if(this.walktimer < 1)
            {
               this.returnqportal();
               this.walktimer = 0;
               removeEventListener(Event.ENTER_FRAME,this.walkupevent2);
            }
