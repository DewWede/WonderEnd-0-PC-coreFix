         else
         {
            this.mapx = 7;
            if(this.mainstage == 2)
            {
               this.checkunlockstage();
               this.checkstageinfo();
               this.joingame();
               this.trans.gotoAndPlay("white");
            }
            else if(this.retry == 1)
            {
               gotoAndStop("title");
            }
            else
            {
               this.joingame();
               this.retry = 1;
            }
            if(this.retry == 2)
            {
               this.trans.gotoAndPlay("fadein");
            }
            else
            {
               this.trans.gotoAndPlay("white");
            }
         }
      }
      
