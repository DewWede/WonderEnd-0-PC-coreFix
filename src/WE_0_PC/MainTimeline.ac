               this.setspeed = this.walkspeed;
               if(this.onground == true && this.jumping == false)
               {
                  if(this.flashlight == 1)
                  {
                     if(this.hp >= 2)
                     {
                        this.char.char.gotoAndPlay("walk");
                     }
                     else
                     {
                        this.char.char.gotoAndPlay("hurtwalk");
                     }
                  }
                  else if(this.flashlight == 2)
