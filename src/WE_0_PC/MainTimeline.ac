      public function nwalkevent(param1:Event) : void
      {
         var _loc2_:* = undefined;
         _loc2_ = 1;
         while(_loc2_ <= 6)
         {
            if(this["nwalk" + _loc2_] == 2)
            {
               if(this["ndir" + _loc2_] == 2)
               {
                  this.bgscene["npc" + _loc2_].x -= 6;
               }
               else if(this["ndir" + _loc2_] == 3)
               {
                  this.bgscene["npc" + _loc2_].x += 6;
               }
            }
            else if(this["nwalk" + _loc2_] == 3)
            {
               if(this["ndir" + _loc2_] == 2)
               {
                  this.bgscene["npc" + _loc2_].x -= 10;
               }
               else if(this["ndir" + _loc2_] == 3)
               {
                  this.bgscene["npc" + _loc2_].x += 10;
               }
            }
            if(this["nwalk" + _loc2_] >= 2)
            {
               if(this["ndir" + _loc2_] == 2)
               {
                  if(this.bgscene["npc" + _loc2_].x < this["nxpos" + _loc2_])
                  {
                     this.bgscene["npc" + _loc2_].x = this["nxpos" + _loc2_];
                     this.bgscene["npc" + _loc2_].gotoAndPlay("still");
                     this["nwalk" + _loc2_] = 1;
                  }
               }
               else if(this["ndir" + _loc2_] == 3)
               {
                  if(this.bgscene["npc" + _loc2_].x > this["nxpos" + _loc2_])
                  {
                     this.bgscene["npc" + _loc2_].x = this["nxpos" + _loc2_];
                     this.bgscene["npc" + _loc2_].gotoAndPlay("still");
                     this["nwalk" + _loc2_] = 1;
                  }
               }
            }
            _loc2_++;
         }
         if(this.nwalk1 == 1 && this.nwalk2 == 1 && this.nwalk3 == 1 && this.nwalk4 == 1 && this.nwalk5 == 1 && this.nwalk6 == 1)
         {
            removeEventListener(Event.ENTER_FRAME,this.nwalkevent);
         }
      }
      
