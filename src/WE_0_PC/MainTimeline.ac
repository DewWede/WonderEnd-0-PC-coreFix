      public function talkchecktimerx(param1:Event) : void
      {
         if(this.pause == 1)
         {
            if(this.talkxx.chatx.chatx.chatx.tb.length >= this.talkxx.cchat.length)
            {
               --this.timerx;
               if(this.timerx < 1)
               {
                  this.timerx = 0;
                  this.talkxx.chatx.chatx.skipbt.visible = true;
                  removeEventListener(Event.ENTER_FRAME,this.talkchecktimerx);
               }
            }
         }
      }
      
