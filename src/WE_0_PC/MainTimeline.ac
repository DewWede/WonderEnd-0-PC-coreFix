                  this.denkichancernd = Math.floor(Math.random() * this.denkichance) + 1;
                  this.puppetchancernd = Math.floor(Math.random() * this.puppetchance) + 1;
                  this.crasherchancernd = Math.floor(Math.random() * this.crasherchance) + 1;
                  this.talismanchancernd = Math.floor(Math.random() * this.talismanchance) + 1;
                  this.moonchancernd = Math.floor(Math.random() * this.moonchance) + 1;
                  if(this.difficulty >= 1)
                  {
                     this.trydenki();
                     this.trypuppet();
                     this.trytalisman();
                     this.trycrasher();
                  }
                  if(this.difficulty >= 3)
                  {
                     this.trymoon();
                  }
                  this.checkdebug();
                  this.resettimer = 60;
                  if((this.puppetset >= 2 && this.puppetset <= 10 || this.crasherset >= 4 && this.crasherset <= 6 || this.monwindow >= 2 && this.monwindow <= 4) && this.poweron == 2)
                  {
                     if(this.alertonce == 1)
                     {
                        if(this.qmap == 1)
                        {
                           this.sfx = 20;
                           this.playsfx();
                        }
                        if(this.poweron == 2)
                        {
                           this.bg.glowx.signx.visible = true;
                        }
                        this.alertonce = 2;
                     }
                  }
                  else
                  {
                     this.bg.glowx.signx.visible = false;
                     this.alertonce = 1;
                  }
                  this.showtime();
               }
            }
         }
      }
      
