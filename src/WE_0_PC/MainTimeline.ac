      public function taskdownloading(param1:Event) : void
      {
         if(this.pause == 1)
         {
            if(this.taskdownload == this.maxdownloadtimer - 1 && this.qmap == 1)
            {
               this.sfx = 38;
               this.playsfx();
               this.taskdownload += 1;
            }
            else if(this.taskdownload < this.maxdownloadtimer)
            {
               this.taskdownload += 1;
               if(this.poweron == 2)
               {
                  this.bg.glowx.pc.gotoAndStop(1);
                  this.bg.glowx.pc.barx.scaleX = this.taskdownload / this.maxdownloadtimer;
                  this.bg.glowx.pc.dreambarx.scaleX = this.min / 360;
               }
               else
               {
                  this.bg.glowx.pc.gotoAndStop(3);
               }
               if(this.pcgamestart == 1 && this.openpc >= 2)
               {
                  this.pc.pc.pages.loadbar.scaleX = this.taskdownload / this.maxdownloadtimer;
               }
            }
            else
            {
               if(this.poweron == 2)
               {
                  this.bg.glowx.pc.gotoAndStop(2);
                  this.bg.glowx.pc.barx.scaleX = this.taskdownload / this.maxdownloadtimer;
                  this.bg.glowx.pc.dreambarx.scaleX = this.min / 360;
               }
               else
               {
                  this.bg.glowx.pc.gotoAndStop(3);
               }
               if(this.pcgamestart == 1 && this.openpc >= 2)
               {
                  this.taskready = 2;
                  this.pc.pc.pages.loadbar.scaleX = this.taskdownload / this.maxdownloadtimer;
                  this.pc.pc.pages.beginbt.gotoAndStop(this.taskready);
                  this.pc.pc.pages.downx.gotoAndStop("found");
                  this.pc.pc.pages.char.gotoAndPlay("still");
                  removeEventListener(Event.ENTER_FRAME,this.taskdownloading);
               }
               else
               {
                  this.taskready = 2;
                  removeEventListener(Event.ENTER_FRAME,this.taskdownloading);
               }
            }
         }
      }
      
