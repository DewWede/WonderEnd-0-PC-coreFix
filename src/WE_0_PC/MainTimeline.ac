      public function nullhandgo() : void
      {
         this.phasetimer = 300;
         this.handlocker = 1;
         this.handspeed = 0;
         this.bg.handx.x = 0;
         this.bg.handx.y = 250;
         this.bg.handx.visible = true;
         this.bg.handx.gotoAndStop(1);
         trace("nullhandgo");
         addEventListener(Event.ENTER_FRAME,this.nullhand_event);
      }
      
      public function nullhand_event(param1:Event) : void
      {
         if(this.pause == 1)
         {
            if(this.phasetimer < 1 && (this.handlocker == 1 || this.handlocker == 3))
            {
               this.walltimer = 50;
               this.nullphase = 0;
               this.phasetimer = 0;
               this.bg.handx.gotoAndPlay(2);
               removeEventListener(Event.ENTER_FRAME,this.nullhand_event);
            }
            else if(this.handlocker == 1)
            {
               --this.phasetimer;
               if(this.handspeed < 40)
               {
                  this.handspeed += 1;
               }
               this.bg.handx.x += this.handspeed;
               this.bg.handx.y = this.char.y - 150;
               if(this.bg.handx.x > this.char.x && this.char.y < 460)
               {
                  this.hidefg.gotoAndStop(2);
                  this.char.visible = true;
                  this.bg.handx.y = 220;
                  this.handspeed = 0;
                  this.handlocker = 2;
                  this.xvelocity = 0;
                  this.yvelocity = 0;
                  this.walkrightstop();
                  this.walkleftstop();
                  this.stopall = 2;
                  this.stopmonster = 2;
                  this.staticfg.gotoAndPlay("glitch2");
                  this.hidefg.gotoAndStop("escape");
                  this.ui.visible = false;
                  if(this.difficulty == 1)
                  {
                     this.escapetries = 3 + this.plusescape;
                  }
                  else
                  {
                     this.escapetries = 6 + this.plusescape;
                  }
                  this.escapetriesmax = this.escapetries;
                  this.bg.handx.handx.visible = false;
                  this.char.char.gotoAndPlay("grab");
                  if(this.flashlight == 1)
                  {
                     this.char.char.lantern.visible = false;
                  }
                  this.alanface = 2;
                  this.changeface();
                  this.char.char.grabx.gotoAndStop(1);
                  this.camshakego();
                  this.jumpscare = 10;
               }
            }
            else if(this.handlocker == 2)
            {
               --this.phasetimer;
               if(this.handspeed < 30)
               {
                  this.handspeed += 0.2;
               }
               if(this.handspeed > 10)
               {
                  this.handspeed += 2;
               }
               if(this.bg.handx.y > 120)
               {
                  this.bg.handx.y -= 0.5;
               }
               this.bg.handx.x -= this.handspeed;
               this.char.x = this.bg.handx.x;
               this.char.y = this.bg.handx.y + 150;
               this.char.scaleX = this.charscale;
               if(this.bg.handx.x < -50)
               {
                  this.hp = 1;
                  this.jumpscare = 10;
                  this.gethurt();
                  trace("dead");
                  removeEventListener(Event.ENTER_FRAME,this.nullhand_event);
                  this.char.visible = false;
               }
            }
            else if(this.handlocker == 3)
            {
               --this.phasetimer;
               this.handspeed -= 3;
               this.bg.handx.x -= this.handspeed;
               if(this.handspeed < 1)
               {
                  this.handspeed = 0;
                  this.handlocker = 1;
               }
            }
         }
      }
      
