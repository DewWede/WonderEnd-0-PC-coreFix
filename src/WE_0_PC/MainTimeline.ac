                        this.char.char.gotoAndPlay("still_light");
                     }
                     else
                     {
                        this.char.char.gotoAndPlay("hurtstill_light");
                     }
                  }
               }
            }
            if(this.dropstage == "intro")
            {
               this.myChannel2.stop();
            }
            this.walking = 1;
            this.ui.arrowkeys.gotoAndStop(1);
         }
         else if(this.walking == 2 && this.openpc == 3 && this.pcgamestart == 2)
         {
            if(this.walktimer <= 0)
            {
               if(this.onground)
               {
                  this.pc.pc.char.gotoAndPlay("still");
               }
            }
            this.walking = 1;
            this.ui.arrowkeys.gotoAndStop(1);
         }
