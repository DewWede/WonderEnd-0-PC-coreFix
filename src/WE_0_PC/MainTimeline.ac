      public function resetpass() : void
      {
         var _loc1_:* = undefined;
         if(this.secretx == 1)
         {
            this.numplace1 = Math.floor(Math.random() * 18) + 1;
            this.numplace2 = Math.floor(Math.random() * 30) + 1;
            this.numplace3 = Math.floor(Math.random() * 36) + 1;
            this.totalhash = 30;
            this.goodfilearray1.sort(this.randomizearray);
         }
         else if(this.secretx == 2)
         {
            this.numplace1 = Math.floor(Math.random() * 36) + 1;
            this.numplace2 = Math.floor(Math.random() * 40) + 1;
            this.numplace3 = Math.floor(Math.random() * 48) + 1;
            this.totalhash = 33;
            this.goodfilearray2.sort(this.randomizearray);
         }
         else if(this.secretx == 3)
         {
            this.numplace1 = Math.floor(Math.random() * 54) + 1;
            this.numplace2 = Math.floor(Math.random() * 50) + 1;
            this.numplace3 = Math.floor(Math.random() * 60) + 1;
            this.totalhash = 36;
            this.goodfilearray3.sort(this.randomizearray);
         }
         else if(this.secretx == 4)
         {
            this.numplace1 = Math.floor(Math.random() * 72) + 1;
            this.numplace2 = Math.floor(Math.random() * 60) + 1;
            this.numplace3 = Math.floor(Math.random() * 72) + 1;
            this.totalhash = 38;
            this.goodfilearray4.sort(this.randomizearray);
         }
         else if(this.secretx == 5)
         {
            this.numplace1 = Math.floor(Math.random() * 81) + 1;
            this.numplace2 = Math.floor(Math.random() * 72) + 1;
            this.numplace3 = Math.floor(Math.random() * 84) + 1;
            this.totalhash = 40;
            this.goodfilearray5.sort(this.randomizearray);
         }
         this.folderpage = 1;
         this.hashpicked = 0;
         this.docpick = 0;
         this.unlocks = 3;
         this.filepics.sort(this.randomizearray);
         this.filearray.sort(this.randomizearray);
         this.notearray.sort(this.randomizearray);
         this.twonderarray.sort(this.randomizearray);
         this.commentarray.sort(this.randomizearray);
         this.hashtagarray.sort(this.randomizearray);
         this.pricearray.sort(this.randomizearray);
         this.menuarray.sort(this.randomizearray);
         this.correcthasharray.sort(this.randomizearray);
         this.encryptarray.sort(this.randomizearray);
         this.ea.sort(this.randomizearray);
         this.correctfilearray.sort(this.randomizearray);
         _loc1_ = 1;
         while(_loc1_ <= 40)
         {
            this["hashtagx" + _loc1_] = 1;
            _loc1_++;
         }
         _loc1_ = 1;
         while(_loc1_ <= 5)
         {
            this["spam" + _loc1_] = 1;
            _loc1_++;
         }
         _loc1_ = 1;
         while(_loc1_ <= 147)
         {
            this["err" + _loc1_] = 1;
            _loc1_++;
         }
         _loc1_ = 1;
         while(_loc1_ <= 6)
         {
            this["lockx" + _loc1_] = 0;
            this["snum" + _loc1_] = Math.floor(Math.random() * 10) + 0;
            _loc1_++;
         }
         trace("resetpass");
      }
      
      public function homeupdate() : void
      {
         if(this.lag == 3)
         {
            stage.quality = StageQuality.LOW;
         }
         else
         {
            stage.quality = StageQuality.LOW;
         }
         this.openbg.gotoAndStop(this.lang);
         if(this.unlockstages == 21)
         {
            this.homebg.gotoAndStop(2);
         }
         else
         {
            this.homebg.gotoAndStop(1);
         }
         this.openbg.yunix.visible = false;
         this.openbg.lemox.visible = false;
         this.openbg.mokax.visible = false;
         this.openbg.rabix.visible = false;
         this.openbg.alanx.gotoAndStop(1);
         if(this.unlockstages >= 3)
         {
            this.openbg.yunix.visible = true;
         }
         if(this.unlockstages >= 5)
         {
            this.openbg.lemox.visible = true;
         }
         if(this.unlockstages >= 7)
         {
            this.openbg.mokax.visible = true;
         }
         if(this.unlockstages >= 9)
         {
            this.openbg.rabix.visible = true;
         }
         if(this.unlockstages >= 11 && (this.o2 == 2 || this.o2 == 0))
         {
            this.openbg.alanx.gotoAndStop(2);
         }
         if(this.unlockstages >= 21)
         {
            this.openbg.alanx.gotoAndStop(3);
         }
         if(this.wonderx.pagepick == 1 && this.o1 == 0)
         {
            this.wonderx.checkaccess();
         }
      }
      
      public function addcpucheck() : void
      {
         addEventListener(Event.ENTER_FRAME,this.cpucheck);
      }
      
      public function cpucheck(param1:Event) : void
      {
         --this.cputimer;
         if(this.cputimer < 1)
         {
            if(this.cpubreak == 1)
            {
               this.cpu -= Math.floor(Math.random() * 3) + 2;
               if(this.cpu < 6)
               {
                  this.cpu = Math.floor(Math.random() * 3) + 3;
               }
               this.cputimer = 30;
            }
            else if(this.cpubreak == 2)
            {
               this.cpu -= Math.floor(Math.random() * 4) + 3;
               if(this.cpu < 50)
               {
                  this.cpubreak = 1;
                  if(this.wonderx.pagepick >= 2)
                  {
                     this.wonderx.windowx.unrespond.gotoAndPlay("relax");
                  }
               }
               this.cputimer = 10;
            }
         }
         if(this.geterror == 2 && this.cpubreak == 1)
         {
            this.geterror = 1;
            if(this.secretx == 1)
            {
               this.cpu += Math.floor(Math.random() * 2) + 1;
            }
            else if(this.secretx == 2)
            {
               this.cpu += Math.floor(Math.random() * 2) + 2;
            }
            else if(this.secretx == 3)
            {
               this.cpu += Math.floor(Math.random() * 3) + 2;
            }
            else if(this.secretx == 4)
            {
               this.cpu += Math.floor(Math.random() * 3) + 3;
            }
            else if(this.secretx == 5)
            {
               this.cpu += Math.floor(Math.random() * 4) + 3;
            }
            if(this.cpu >= 100)
            {
               this.cpu = 100;
               this.cpubreak = 2;
               this.cputimer = 20;
               if(this.wonderx.currentFrame == 5)
               {
                  this.wonderx.windowx.unrespond.gotoAndPlay(3);
               }
            }
         }
         if(this.wonderx.currentFrame == 5)
         {
            this.wonderx.windowx.cpubar.scaleX = this.cpu / 100;
            this.wonderx.windowx.cpux.text = this.cpu + "%";
            if(this.cpu >= 50)
            {
               this.wonderx.windowx.cpubar.gotoAndStop(2);
            }
            else
            {
               this.wonderx.windowx.cpubar.gotoAndStop(1);
            }
         }
      }
      
