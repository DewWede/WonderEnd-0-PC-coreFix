               {
                  this.mainfg.star1.alpha = 1;
                  this.mainfg.star2.alpha = 1;
                  this.mainfg.star3.alpha = 1;
                  this.mainfg.star4.alpha = 1;
               }
               else if(this.part >= 1 && this.part < 31)
               {
                  this.mainfg.star1.alpha = 0.5;
                  this.mainfg.star2.alpha = 0.5;
