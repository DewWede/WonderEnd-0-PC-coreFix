      public function playtext() : void
      {
         p.start();
         p.setTextField(this.talk2.chatx.chatx.tb);
         if(this.fpsx == 1)
         {
            p.setCharInterval(28);
         }
         else
         {
            p.setCharInterval(2);
         }
         p.addTextPiece(p.fitLines(this.cchat));
         p.playPiece(0);
         if(this.chat == this.maxchat)
         {
            talktimer = 120;
         }
         else
         {
            talktimer = 60;
         }
         if(this.chat <= this.maxchat)
         {
            addEventListener(Event.ENTER_FRAME,this.checkendtext);
         }
      }
      
      public function checkendtext(param1:Event) : void
      {
         if(this.pause == 1)
         {
            if(this.talk2.chatx.chatx.tb.length >= this.cchat.length)
            {
               talktimer -= 1;
               if(talktimer < 1)
               {
                  talktimer = 999;
                  if(this.chat >= this.maxchat)
                  {
                     this.talk2.gotoAndPlay("quit");
                  }
                  else
                  {
                     this.chat += 1;
                     this.starttext();
                  }
                  removeEventListener(Event.ENTER_FRAME,this.checkendtext);
               }
            }
         }
      }
      
      public function gotalk() : void
      {
         if(this.talk2.currentFrame > 2)
         {
            this.talk2.chatx.chatx.tb.text = "";
            this.talk2.gotoAndStop(2);
            removeEventListener(Event.ENTER_FRAME,this.checkendtext);
         }
         talktimer = 999;
         this.movestop();
         this.onepush = 1;
         this.walkleftstop();
         this.walkrightstop();
         this.part = 1;
         this.stopani = 0;
         this.timerx = 0;
         if(this.extrahit == 4)
         {
            if(this.difficulty == 3)
            {
