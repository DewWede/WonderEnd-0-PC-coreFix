      public function movecheck(param1:Event) : void
      {
         if(this.controlsx == 2)
         {
            if(this.mousexpos < this.setstart - 4)
            {
               this.char.scaleX = -this.charscale;
               this.chardir = 2;
               this.touchgo = 3;
               this.walkleft();
            }
            else if(this.mousexpos > this.setstart + 4)
            {
               this.char.scaleX = this.charscale;
               this.chardir = 1;
               this.touchgo = 4;
               this.walkright();
            }
            else if(this.touchgo >= 3)
            {
               if(this.touchgo == 3)
               {
                  this.walkleftstop();
               }
               else
               {
                  this.walkrightstop();
               }
               this.touchgo = 1;
            }
         }
         else if(this.mousexpos <= 172)
         {
            this.char.scaleX = -this.charscale;
            this.chardir = 2;
            this.touchgo = 3;
            this.walkleft();
         }
         else
         {
            this.char.scaleX = this.charscale;
            this.chardir = 1;
            this.touchgo = 4;
            this.walkright();
         }
      }
      
