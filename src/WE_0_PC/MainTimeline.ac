      public function endloop_start() : void
      {
         this.char.x = 1350;
         this.bgmid.x = 0;
         this.bgback.x = 0;
         this.npcscale1 = this.bg.yunix.scaleX;
         this.npcscale2 = this.bg.endhall.mon3.scaleX;
         this.monsterscale4 = this.bg.flyinghead.scaleX;
         this.ahallway = 0;
         this.endlives = 5;
         this.yunispeed = 4;
         this.rngchance = 0;
         this.startside = 1;
         this.resetloop();
         addEventListener(Event.ENTER_FRAME,this.endloop_event);
      }
      
      public function endloop_event(param1:Event) : void
      {
         if(this.pause == 1)
         {
            if(this.char.x > 7157)
            {
               this.endside = 2;
               this.checkloopwin();
               this.startside = 1;
               this.char.x = 480;
               this.resetloop();
            }
            else if(this.char.x < 475)
            {
               this.endside = 1;
               this.checkloopwin();
               this.startside = 2;
               this.char.x = 7153;
               this.resetloop();
            }
            if(this.startside == 1)
            {
               this.bg.yunix.x -= this.yunispeed;
            }
            else if(this.startside == 2)
            {
               this.bg.yunix.x += this.yunispeed;
            }
         }
      }
      
      public function checkloopwin() : void
      {
         trace("startside = " + this.startside + " / " + "endside = " + this.endside + " / " + "anomaly = " + this.anomaly);
         if(this.startside == 1 && this.endside == 2)
         {
            if(this.anomaly >= 1)
            {
               this.ahallway = 0;
            }
            else
            {
               this.ahallway += 1;
            }
         }
         else if(this.startside == 1 && this.endside == 1)
         {
            if(this.anomaly >= 1)
            {
               if(this.ahallway < 10)
               {
                  this.ahallway += 1;
               }
            }
            else
            {
               this.ahallway = 0;
            }
         }
         else if(this.startside == 2 && this.endside == 1)
         {
            if(this.anomaly >= 1)
            {
               this.ahallway = 0;
            }
            else
            {
               this.ahallway += 1;
            }
         }
         else if(this.startside == 2 && this.endside == 2)
         {
            if(this.anomaly >= 1)
            {
               if(this.ahallway < 10)
               {
                  this.ahallway += 1;
               }
            }
            else
            {
               this.ahallway = 0;
            }
         }
         if(this.ahallway == 0)
         {
            this.jumpscare = 17;
            this.gethurt();
            this.canthittimer = 15;
            if(this.hp < 1)
            {
               this.char.char.gotoAndPlay("panic");
            }
         }
         if(this.ahallway >= 11)
         {
            this.clearstage();
         }
         trace("check win");
      }
      
