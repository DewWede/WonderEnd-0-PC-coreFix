      {
         this.trans.gotoAndPlay("memory");
      }
      
      public function exitmap2() : void
      {
         if(this.particleadd == 2)
         {
            this.removeParticles();
            this.particleadd = 1;
         }
         if(this.bgscene.currentFrame == 5)
         {
            this.bgscene.tvx.tvx.char.gotoAndStop(1);
            this.bgscene.tvx.gotoAndStop(1);
         }
         this.stopmusic();
         this.stopsfx();
         this.stopvoice();
         this.bgscene.gotoAndStop("none");
         removeChild(this.bgscene);
         this.bgscene = null;
         removeChild(this.staticfgx);
         this.staticfgx = null;
         removeChild(this.pausemenux);
         this.pausemenux = null;
         removeChild(this.pausebt2);
         this.pausebt2 = null;
         removeChild(this.skipallbt);
         this.skipallbt = null;
         removeChild(this.hideallbt);
         this.hideallbt = null;
         removeEventListener(Event.ENTER_FRAME,this.talkchecktimerx);
         removeEventListener(Event.ENTER_FRAME,this.camshakeeventx);
         trace("winner = " + this.winner);
         if(this.storypick >= 1)
         {
            this.talkxx.endevent();
         }
         removeChild(this.talkxx);
         this.talkxx = null;
         if(this.o1 == 2)
         {
            this.retry = 1;
            gotoAndStop("title");
            this.trans.gotoAndPlay("white");
         }
         else if(this.retry == 2)
         {
            this.trans.gotoAndPlay("fadein");
            gotoAndStop("reload");
            this.retry = 1;
         }
         else if(this.winner == 4 || this.winner == 5)
         {
            trace("reload1");
            this.retry = 1;
            gotoAndStop("title");
         }
         else if(this.winner == 6)
         {
            trace("reload2");
            this.winner = 1;
            this.retry = 1;
            gotoAndStop("title");
         }
         else if(this.winner == 2 && this.cutstagepick >= 1)
         {
            trace("reload3");
            this.winner = 3;
            gotoAndStop("reload");
         }
         else
         {
            trace("reload4");
            this.stopall = 1;
            this.winner = 1;
            this.retry = 1;
            if(this.stagepick == 11)
            {
               this.o2 = 2;
               this.savex();
               gotoAndStop("title");
            }
            else if(this.stagepick == 21)
            {
               this.savex();
               gotoAndStop("title");
            }
            else
            {
               if(this.mainstage == 1 && this.intropart == 2)
               {
                  trace("go intro2");
                  this.droptitle == "Intro";
                  this.checkstageinfo();
               }
               else
               {
                  this.checkunlockstage();
                  this.checkstageinfo();
               }
               gotoAndStop("game");
            }
            this.trans.gotoAndPlay("white");
         }
      }
      
